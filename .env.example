# Autonomous Engineering Swarm - Environment Configuration
# Copy this file to .env and configure values

# Database Configuration (Defaults to SQLite for instant local zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./swarm.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/swarm

# Concurrency & Reliability
MAX_CONCURRENT_CODING_WORKERS=8
MAX_DEFECT_RETRIES=3
DEFAULT_TASK_LEASE_SECONDS=600

# GitHub Integration
GITHUB_TOKEN=ghp_example_token_placeholder
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Simulation Mode (Set False for live GitHub API & real VM execution)
SIMULATION_MODE=True

# Application Ports
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
